# Copy to .env (gitignored) and fill in real values.
# Required by scripts/start.js (SERVICE_SECRET) and Prisma (DATABASE_URL).

# HTTP port for every microservice (gateway lives on API_SERVICE_PORT)
API_SERVICE_PORT=4000

# Comma-separated browser origins allowed by CORS.
# Must include the console (4002) and admin (4003) dev origins.
CORS_ORIGINS=http://localhost:4002,http://localhost:4003,http://localhost:8082

# PostgreSQL connection string (Neon pooler endpoint, or any local Postgres).
DATABASE_URL=postgresql://user:password@host:5432/FMS?sslmode=require

# Local dev secrets - generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
SERVICE_SECRET=
MFA_SECRET=
